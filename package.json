{
	"name": "react-color-scheme-switch",
	"version": "2.0.0",
	"description": "Tri-state toggle to switch between light, dark, and automatic mode ☀️🌓🌒",
	"license": "GPL-3.0",
	"repository": "github:flying-sheep/react-color-scheme-switch",
	"homepage": "https://flying-sheep.github.io/react-color-scheme-switch/",
	"bugs": "https://github.com/flying-sheep/react-color-scheme-switch/issues",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"sideEffects": false,
	"engines": {
		"node": ">=17.4"
	},
	"packageManager": "yarn@4.18.0",
	"scripts": {
		"prepare": "husky install",
		"build": "rollup --configPlugin=typescript --config=rollup.config.ts",
		"watch": "yarn build -w",
		"serve": "npx serve -s docs",
		"start": "npx concurrently 'npm:watch' 'npm:serve'",
		"lint": "xo --fix",
		"prepack": "yarn build"
	},
	"files": [
		"./dist/",
		"./src/"
	],
	"keywords": [
		"react",
		"typescript"
	],
	"dependencies": {
		"@react-spring/web": "^10.1.2"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@mdx-js/rollup": "^3.1.1",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-replace": "^6.0.3",
		"@rollup/plugin-typescript": "^12.3.0",
		"@types/eslint": "^9.6.1",
		"@types/node": "^26.5.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@types/remark-prism": "^1.3.7",
		"@typescript-eslint/eslint-plugin": "^8.70.0",
		"@typescript-eslint/parser": "^8.70.0",
		"@web/rollup-plugin-html": "^4.0.0",
		"@yarnpkg/sdks": "^3.3.1",
		"eslint": "^10.10.0",
		"eslint-config-xo-react": "^0.32.0",
		"eslint-config-xo-typescript": "^11.0.0",
		"eslint-import-resolver-node": "^0.4.0",
		"husky": "^9.1.7",
		"postcss": "^8.5.28",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"remark-prism": "^1.3.6",
		"rollup": "^4.63.1",
		"rollup-plugin-postcss": "^4.0.2",
		"rollup-plugin-serve": "github:thgh/rollup-plugin-serve#v3.0.1",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"unified": "^11.0.5",
		"xo": "^5.0.1"
	},
	"peerDependencies": {
		"react": ">=18.2.0",
		"react-dom": ">=18.2.0"
	},
	"dependenciesMeta": {
		"@react-spring/core": {
			"built": false
		}
	},
	"resolutions": {
		"xo/eslint-import-resolver-webpack": "npm:dequal@2.0.3"
	}
}
